# Slim base, non-root user, no build toolchain in the final image.
FROM python:3.12-slim

# Dependencies first so a code change does not invalidate the layer that installs them.
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

# The corpus this service answers from. Baked in deliberately: it is generated by a
# seeded script and versioned with the code, so the image is the whole system rather
# than the code plus a hope about what is mounted.
COPY corpus/ ./data/corpus/

# Run as nobody. A container running as root has isolated the filesystem from you
# and not from whatever gets into the process.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

EXPOSE 8000
# API_KEYS has no default on purpose — the service refuses to start without it,
# which is preferable to a default that ships to production unchanged.
ENV RATE_LIMIT=10 RATE_WINDOW_S=60 CORPUS_DIR=/app/data/corpus \
    GENERATION_ENDPOINTS=http://host.docker.internal:11455/v1
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health', timeout=4).status==200 else 1)"

CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8000"]
